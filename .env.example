# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# Values below are placeholders, not real credentials.
# ---------------------------------------------------------------------------

# --- Public client configuration -------------------------------------------
# NEXT_PUBLIC_* is inlined into the browser bundle. Only non-secret values here.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Observability -----------------------------------------------------------
# debug | info | warn | error. Defaults to "debug" in development and "info" in
# production, so this only needs setting to override that.
LOG_LEVEL=""

# --- Server-only secrets ----------------------------------------------------
# Must never be prefixed with NEXT_PUBLIC_ and never referenced from a client
# component. Bypasses Row Level Security, so use only where genuinely required.
SUPABASE_SECRET_KEY=""

# --- Meta / WhatsApp Business Platform --------------------------------------
# Optional: the product runs without these, and the WhatsApp connection screen
# reports "not configured" rather than failing. Onboarding needs both the app
# id (to start Embedded Signup) and the secret (to complete the exchange
# server-side). See docs/integrations/whatsapp.md.
META_APP_ID=""
META_APP_SECRET=""
# The same app id, plus the Facebook Login for Business configuration id, as the
# browser needs them to launch Embedded Signup. Public: both are visible during
# Meta's own flow and authorize nothing without the secret above.
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_CONFIG_ID=""
# Arbitrary string we choose; Meta echoes it back during webhook verification.
META_WEBHOOK_VERIFY_TOKEN=""

# --- Gemini (post-MVP, unused before then) ---------------------------------
GEMINI_API_KEY=""
